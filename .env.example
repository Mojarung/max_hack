# Скопируйте в .env и заполните. Без изменений всё работает в мок-режиме.

# --- MAX ---
# Токен бота от организаторов хакатона (business.max.ru). Пусто = только эмулятор чата.
MAX_BOT_TOKEN=
# Ник бота без @, нужен для диплинков https://max.ru/<ник>?startapp=...
MAX_BOT_USERNAME=domovoy_kuzya_bot
MAX_API_URL=https://platform-api2.max.ru
# true: вход в мини-приложение без подписи MAX, демо-жители и эмулятор чата
MOCK_MAX=true
SEED_DEMO=true

# --- LLM ---
# stub | ollama_cloud | ollama_local
LLM_PROVIDER=stub
LLM_MODEL=gpt-oss:120b
# Ключ Ollama Cloud: https://ollama.com/settings/keys
OLLAMA_API_KEY=
OLLAMA_LOCAL_URL=http://host.docker.internal:11434

# Дополнительные MCP-серверы для агента (JSON). Их же можно добавить в приложении: Ещё → MCP.
EXTRA_MCP_SERVERS=[]

# --- Механики ---
DEFAULT_VOTE_THRESHOLD_PCT=15
MIN_VOTES_NEEDED=3
EVENT_REMINDER_MINUTES=120

# --- Инфраструктура (значения по умолчанию для docker compose) ---
POSTGRES_PASSWORD=domovoy
RABBIT_USER=domovoy
RABBIT_PASSWORD=domovoy
MINIO_ROOT_USER=domovoy
MINIO_ROOT_PASSWORD=domovoy-secret

# Для локального запуска через uv (сервисы из docker compose на localhost):
# DATABASE_URL=postgresql+asyncpg://domovoy:domovoy@localhost:5432/domovoy
# RABBIT_URL=amqp://domovoy:domovoy@localhost:5672/
# S3_ENDPOINT=localhost:9000
# S3_ACCESS_KEY=domovoy
# S3_SECRET_KEY=domovoy-secret
# INTERNAL_MCP_URL=http://localhost:8765/mcp
